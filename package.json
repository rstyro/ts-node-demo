{
  "name": "ts-node-demo",
  "version": "1.0.0",
  "description": "从零搭建一个企业级的 Node.js + TypeScript 项目，涵盖初始化、配置、开发、调试、测试、构建及部署全流程。",
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "concurrently \"tsc --watch\" \"tsc-alias -w\" \"nodemon dist/server.js\"",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstyro/ts-node-demo.git"
  },
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/rstyro/ts-node-demo#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mysql2": "^3.22.3",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
